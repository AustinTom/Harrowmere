; Engine configuration file.
config_version=5

[application]

config/name="Harrowmere"
config/description="First playable prototype: one corner of the Meltlands."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Events="*res://scripts/core/events.gd"
DB="*res://scripts/core/db.gd"
GameState="*res://scripts/core/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[rendering]

anti_aliasing/quality/msaa_3d=2
